{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for ShotCubby's windows",
  "windows": ["popover", "spotlight", "settings", "toast", "copy-toast"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "opener:default"
  ]
}
